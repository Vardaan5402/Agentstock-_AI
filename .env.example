# ==============================================================================
# AGENTSTOCK AI — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=production
DEMO_MODE=false
SECRET_KEY=generate_a_random_64_char_secret_key_for_production_sessions
APP_BASE_URL=https://agentstock.ai

# Database Configuration (SQLite default for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///agentstock.db
# DATABASE_URL=postgresql://agentstock_user:secure_password@postgres-host:5432/agentstock_prod

# Google Gemini Multimodal AI Credentials
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_alternative_google_api_key_here

# Razorpay Payment Gateway (Live credentials for commercial subscription billing)
# AgentStock creates USD Orders from the centralized plan pricing; enable USD settlement/acceptance in Razorpay before production use.
RAZORPAY_KEY_ID=rzp_live_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Platform Administrator Credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=pbkdf2_sha256$260000$your_salted_hash_here

# Google OAuth 2.0 / SSO Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8505/oauth2callback

# SMTP Email Dispatcher Configuration (for supplier POs & OTP emails)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USERNAME=apikey
SMTP_PASSWORD=your_smtp_api_key_here
SMTP_FROM_EMAIL=orders@agentstock.ai

# Audit Log Retention Period (Days)
AUDIT_LOG_RETENTION_DAYS=90
